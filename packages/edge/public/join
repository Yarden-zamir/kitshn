#!/bin/sh
# kitshn join (K-602): installs the kitshn daemon for this user, joins the machine with a one-time
# code, and starts the daemon as a user service (K-601). "Add machine" on the map prints the command:
#
#   curl -fsSL https://kit.example.com/join | sh -s -- <code> https://kit.example.com
#
# Optional: KITSHN_DAEMON (a local kitshn binary instead of the release download).
set -eu

code=${1:-}
server=${2:-}
[ -n "$code" ] && [ -n "$server" ] || {
  echo "usage: curl -fsSL <kitshn address>/join | sh -s -- <code> <kitshn address>" >&2
  exit 1
}

case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=darwin ;;
*)
  echo "kitshn: the daemon runs on Linux and macOS (K-601), not on $(uname -s)." >&2
  exit 1
  ;;
esac
case "$(uname -m)" in
aarch64 | arm64) cpu=arm64 ;;
x86_64 | amd64) cpu=x64 ;;
*)
  echo "kitshn: no daemon build for the CPU $(uname -m)." >&2
  exit 1
  ;;
esac

bin="$HOME/.local/bin"
mkdir -p "$bin"
if [ -n "${KITSHN_DAEMON:-}" ]; then
  cp "$KITSHN_DAEMON" "$bin/kitshn.new"
else
  # K-617: the release that this kitshn names, checked against its SHA256SUMS.
  version=$(curl -fsSL "$server/join/version")
  case "$version" in
  [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  *)
    echo "kitshn: $server names no release ($version), so there is no daemon to download." >&2
    exit 1
    ;;
  esac
  base="https://github.com/Yarden-zamir/kitshn/releases/download/edge-$version"
  echo "Downloading the kitshn daemon of release $version"
  # K-617: the daemon comes gzipped; SHA256SUMS names the .gz file, so the check comes before unpacking.
  curl -fsSL "$base/kitshn-$os-$cpu.gz" -o "$bin/kitshn.new"
  expected=$(curl -fsSL "$base/SHA256SUMS" | awk -v f="kitshn-$os-$cpu.gz" '$2 == f || $2 == "*" f { print $1 }')
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$bin/kitshn.new" | awk '{ print $1 }')
  else
    actual=$(shasum -a 256 "$bin/kitshn.new" | awk '{ print $1 }')
  fi
  if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
    rm -f "$bin/kitshn.new"
    echo "kitshn: the daemon does not match the SHA256SUMS of release $version." >&2
    exit 1
  fi
  if ! gzip -dc "$bin/kitshn.new" > "$bin/kitshn.unpacked"; then
    rm -f "$bin/kitshn.new" "$bin/kitshn.unpacked"
    echo "kitshn: could not unpack the daemon; this needs gzip." >&2
    exit 1
  fi
  mv "$bin/kitshn.unpacked" "$bin/kitshn.new"
fi
chmod 755 "$bin/kitshn.new"
mv "$bin/kitshn.new" "$bin/kitshn"

"$bin/kitshn" join "$code" --server "$server"
"$bin/kitshn" service install
# K-618: the skill for coding agents on this machine. A failure here stops no join.
"$bin/kitshn" skill install || echo "kitshn: the skill was not installed; run $bin/kitshn skill install later." >&2
echo "Done. To remove kitshn from this machine: $bin/kitshn service uninstall"

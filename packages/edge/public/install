#!/bin/sh
# kitshn bootstrap (K-1201 to K-1207). It sets up kitshn on a Cloudflare account, and a second
# run changes only what is not right yet (K-1205). It uses only sh, curl, jq and tar (K-1203).
#
#   curl -fsSL https://kit.yarden-zamir.com/install | \
#     CLOUDFLARE_API_TOKEN=... KITSHN_HOST=kit.example.com KITSHN_OWNER_EMAILS=you@example.com sh
#
# Optional: KITSHN_ACCOUNT_ID (when the token sees more than one account), KITSHN_BUNDLE (a URL or a
# local path of kitshn-edge.tar.gz), KITSHN_SET_TOKEN=1 (store a new API token in the Worker),
# KITSHN_GITHUB_CLIENT_ID and KITSHN_GITHUB_CLIENT_SECRET (add GitHub login, K-102),
# KITSHN_OWNER_DEVICES (a JSON list of {tokenId, clientId, name} service tokens that join the Owner
# circle when kitshn starts for the first time, for agents; K-106), KITSHN_DEPLOY_OWNERS (comma-separated
# GitHub user names whose repos may deploy, K-811; a second run keeps the list when it is not set),
# KITSHN_ZONES (comma-separated further zones of the account that the extra addresses of an app may use, K-817;
# a second run keeps the list when it is not set), KITSHN_GITHUB_APP_ID and KITSHN_GITHUB_APP_KEY (the id and the private key file of the kitshn GitHub
# App, so agent keys can start a repo's kitshn workflow, K-718; a second run keeps them unless
# KITSHN_SET_GITHUB_APP=1), KITSHN_IMPORT (a state export, .json or .json.gz, that rebuilds the state of an empty
# kitshn on the same Cloudflare account, K-1833).
set -eu

API=https://api.cloudflare.com/client/v4
SCRIPT=kitshn
BUNDLE=${KITSHN_BUNDLE:-https://github.com/Yarden-zamir/kitshn/releases/download/edge/kitshn-edge.tar.gz}
COMPATIBILITY_DATE=2026-10-20
MFA='{"allowed_authenticators":["biometrics","security_key"],"session_duration":"24h"}'
# K-1202: an account API token with every permission. TOKEN_LINK in src/core/token.ts is the source; a test compares.
TOKEN_LINK='https://dash.cloudflare.com/?to=/:account/api-tokens&permissionGroupKeys=%5B%7B%22key%22%3A%22e086da7e2179491d91ee5f35b3ca210a%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22f7f0eda5697f475c90846e879bab8666%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22bf7481a1826f439697cb59a20b22293e%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%2282c075da3f4647a2a03becd0fe240f8a%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%221e13c5124ca64b72b1969a67e8829049%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22bfe0d8686a584fa680f4c53b5eb0de6d%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22a1c0fec57cf94af79479a6d827fa518c%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%224e5fd8ac327b4a358e48c66fcbeb856d%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22b05b28e839c54467a7d6cba5d3abb5a3%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%22c07321b023e944ff818fec44d8203567%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%22b89a480218d04ceb98b4fe57ca29dc1f%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%22c8fed203ed3043cba015a93ad1616f1f%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%224755a26eedb94da69e1066d98aa820be%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%2228f4b596e7d643029c524985477ae49a%22%2C%22type%22%3A%22edit%22%7D%2C%7B%22key%22%3A%2206f0526e6e464647bd61b63c54935235%22%2C%22type%22%3A%22edit%22%7D%5D&name=kitshn'

say() { printf '%s\n' "$*"; }
changed() { printf '  changed: %s\n' "$*"; }
kept() { printf '  ok:      %s\n' "$*"; }
die() {
  printf 'kitshn: %s\n' "$*" >&2
  exit 1
}

for tool in curl jq tar base64; do
  command -v "$tool" >/dev/null 2>&1 || die "this script needs $tool. Install it and run the script again."
done
[ -n "${CLOUDFLARE_API_TOKEN:-}" ] || die "set CLOUDFLARE_API_TOKEN. Make a token with this link, and give its Zone permissions all zones of the account: $TOKEN_LINK"
[ -n "${KITSHN_HOST:-}" ] || die "set KITSHN_HOST to the admin address, for example kit.example.com."
[ -n "${KITSHN_OWNER_EMAILS:-}" ] || die "set KITSHN_OWNER_EMAILS to your email (a comma-separated list for more)."
[ -z "${KITSHN_IMPORT:-}" ] || [ -r "$KITSHN_IMPORT" ] || die "KITSHN_IMPORT names no readable file: $KITSHN_IMPORT"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

# api METHOD PATH [JSON]: prints the result. On an error it prints the Cloudflare errors and the
# permission that the call needs ($NEED), then stops.
NEED=""
api() {
  method=$1
  path=$2
  [ $# -ge 3 ] && printf '%s' "$3" >"$WORK/body"
  # A 5xx or Cloudflare's error 10013 ("An unknown error") often passes on a later try, so a call that is safe to
  # repeat tries again: the asset upload session, which makes nothing and fails for minutes at a time, after 5 s and
  # 15 s; GET, PUT, PATCH and DELETE once after 2 s. A POST that makes something could land twice, so it does not repeat.
  case "$method $path" in
  POST*/assets-upload-session) pauses="5 15" ;;
  GET* | PUT* | PATCH* | DELETE*) pauses="2" ;;
  *) pauses="" ;;
  esac
  for pause in $pauses last; do
    if [ $# -ge 3 ]; then
      http_status=$(curl -sS -o "$WORK/out" -w '%{http_code}' -X "$method" "$API$path" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" --data-binary "@$WORK/body") || die "$method $path: no answer from Cloudflare."
    else
      http_status=$(curl -sS -o "$WORK/out" -w '%{http_code}' -X "$method" "$API$path" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN") ||
        die "$method $path: no answer from Cloudflare."
    fi
    [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" = "true" ] && break
    [ "$pause" = last ] && break
    case "$http_status" in 5??) ;; *) jq -e 'any(.errors[]?; .code == 10013)' "$WORK/out" >/dev/null 2>&1 || break ;; esac
    sleep "$pause"
  done
  if [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" != "true" ]; then
    errors=$(jq -r '[.errors[]? | "\(.code): \(.message)" + ([.error_chain[]?.message] | if length > 0 then " (" + join("; ") + ")" else "" end)] | join("; ")' "$WORK/out" 2>/dev/null || head -c 300 "$WORK/out")
    hint=""
    # Only a 401 or a 403 says that the token lacks a permission.
    case "$http_status" in 401 | 403) if [ -n "$NEED" ]; then hint=" The token needs $NEED. Edit the token at ${TOKEN_PAGE:-the Cloudflare dashboard}, or make a new token with this link: $TOKEN_LINK"; fi ;; esac
    die "$method $path failed ($http_status): $errors.$hint"
  fi
  jq -c '.result' "$WORK/out"
}
# try METHOD PATH: like api, but prints nothing and returns 1 on an error. The errors stay in $WORK/out.
try() {
  curl -sS -X "$1" "$API$2" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" >"$WORK/out" 2>/dev/null &&
    [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" = "true" ]
}

say "kitshn bootstrap for $KITSHN_HOST"

say "1. API token and account"
NEED="a valid API token"
# K-1202: the token link makes an account token, which verifies only below its account; /user/tokens/verify answers
# it with error 1000. A user token, as older installs have, verifies at /user/tokens/verify.
TOKEN_PAGE=""
if try GET /user/tokens/verify; then
  TOKEN_KIND=user
  TOKEN_STATUS=$(jq -r .result.status "$WORK/out")
  TOKEN_PAGE=https://dash.cloudflare.com/profile/api-tokens
elif jq -e 'any(.errors[]?; .code == 1000)' "$WORK/out" >/dev/null 2>&1; then
  TOKEN_KIND=account
else
  die "the check of the API token failed: $(jq -r '[.errors[]? | "\(.code): \(.message)"] | join("; ")' "$WORK/out" 2>/dev/null || head -c 300 "$WORK/out")"
fi
NEED="any account permission"
if [ -n "${KITSHN_ACCOUNT_ID:-}" ]; then
  ACCOUNT=$KITSHN_ACCOUNT_ID
else
  accounts=$(api GET /accounts)
  [ "$(printf '%s' "$accounts" | jq length)" = 1 ] ||
    die "the token sees $(printf '%s' "$accounts" | jq length) accounts. Set KITSHN_ACCOUNT_ID to one of: $(printf '%s' "$accounts" | jq -r 'map("\(.id) (\(.name))") | join(", ")')"
  ACCOUNT=$(printf '%s' "$accounts" | jq -r '.[0].id')
fi
if [ "$TOKEN_KIND" = account ]; then
  NEED="a valid API token"
  verify=$(api GET "/accounts/$ACCOUNT/tokens/verify")
  TOKEN_STATUS=$(printf '%s' "$verify" | jq -r .status)
  TOKEN_PAGE="https://dash.cloudflare.com/$ACCOUNT/api-tokens"
fi
[ "$TOKEN_STATUS" = active ] || die "the API token is $TOKEN_STATUS, not active."
NEED='"Zone > Zone > Read"'
zones=$(api GET "/zones?account.id=$ACCOUNT&per_page=50")
ZONE=$(printf '%s' "$zones" | jq -r --arg host "$KITSHN_HOST" \
  '[.[] | . as $z | select($z.name == $host or ($host | endswith("." + $z.name)))] | sort_by(.name | length) | last | .id // empty')
[ -n "$ZONE" ] || die "no zone of this account contains $KITSHN_HOST. Add the domain to Cloudflare first (K-1111)."
ZONE_NAME=$(printf '%s' "$zones" | jq -r --arg id "$ZONE" '.[] | select(.id == $id) | .name')
kept "account $ACCOUNT, zone $ZONE_NAME, $TOKEN_KIND token"
# K-1806: Worker log search is optional, so a token without it gets a warning, not a stop.
now=$(($(date +%s) * 1000))
status=$(curl -sS -o "$WORK/out" -w '%{http_code}' -X POST "$API/accounts/$ACCOUNT/workers/observability/telemetry/query" \
  -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "content-type: application/json" \
  -d "{\"queryId\":\"kitshn-logs\",\"view\":\"events\",\"limit\":1,\"dry\":true,\"timeframe\":{\"from\":$((now - 60000)),\"to\":$now},\"parameters\":{}}" 2>&1) || status="no answer"
case "$status" in
200) kept "Worker log search (K-1806)" ;;
403)
  say "  warning: the token has no \"Account > Workers Observability > Edit\", so search in Worker logs is off (K-1806)."
  say "           Live in Worker logs still works. To add it, edit the token at $TOKEN_PAGE, then Update token."
  ;;
*) say "  warning: the check of Worker log search failed ($status): $(jq -r '[.errors[]?.message] | join("; ")' "$WORK/out" 2>/dev/null || head -c 200 "$WORK/out")" ;;
esac

say "2. Zero Trust organization (K-1207)"
NEED='"Account > Access: Organizations, Identity Providers, and Groups > Edit"'
if ! try GET "/accounts/$ACCOUNT/access/organizations"; then
  die "this account has no Zero Trust organization yet. Open https://one.dash.cloudflare.com/$ACCOUNT once, pick a team name and the Free plan, then run this script again."
fi
ORG=$(jq -c .result "$WORK/out")
TEAM=$(printf '%s' "$ORG" | jq -r .auth_domain)
kept "team domain $TEAM"

say "3. One-time PIN login (K-102) and GitHub login"
IDPS=$(api GET "/accounts/$ACCOUNT/access/identity_providers")
if printf '%s' "$IDPS" | jq -e 'any(.[]; .type == "onetimepin")' >/dev/null; then
  kept "One-time PIN login"
else
  api POST "/accounts/$ACCOUNT/access/identity_providers" '{"name":"Email one-time code","type":"onetimepin","config":{}}' >/dev/null
  changed "added the One-time PIN login"
fi
if [ -n "${KITSHN_GITHUB_CLIENT_ID:-}" ] && [ -n "${KITSHN_GITHUB_CLIENT_SECRET:-}" ]; then
  if printf '%s' "$IDPS" | jq -e 'any(.[]; .type == "github")' >/dev/null; then
    kept "GitHub login"
  else
    body=$(jq -nc --arg id "$KITSHN_GITHUB_CLIENT_ID" --arg secret "$KITSHN_GITHUB_CLIENT_SECRET" \
      '{name:"GitHub",type:"github",config:{client_id:$id,client_secret:$secret}}')
    api POST "/accounts/$ACCOUNT/access/identity_providers" "$body" >/dev/null
    changed "added the GitHub login"
  fi
else
  say "  later:   GitHub login. Make a GitHub OAuth app with the callback https://$TEAM/cdn-cgi/access/callback,"
  say "           then run this script again with KITSHN_GITHUB_CLIENT_ID and KITSHN_GITHUB_CLIENT_SECRET."
fi

say "4. Passkeys (K-103) and seat expiration (K-111)"
# The API refuses its own empty service_token_inactivity block in a PUT, so the script drops it.
wanted=$(printf '%s' "$ORG" | jq -c --argjson mfa "$MFA" '
  (if .service_token_inactivity.inactivity_threshold_days == null then del(.service_token_inactivity) else . end) + {
    user_seat_expiration_inactive_time: "730h",
    mfa_config: {
      allowed_authenticators: (((.mfa_config.allowed_authenticators // []) + $mfa.allowed_authenticators) | unique),
      session_duration: (.mfa_config.session_duration // $mfa.session_duration)
    }
  }')
if [ "$(printf '%s' "$ORG" | jq -S '{a: .user_seat_expiration_inactive_time, b: .mfa_config}')" = \
  "$(printf '%s' "$wanted" | jq -S '{a: .user_seat_expiration_inactive_time, b: .mfa_config}')" ]; then
  kept "passkeys and security keys allowed, seats expire after 1 month without a login"
else
  api PUT "/accounts/$ACCOUNT/access/organizations" "$wanted" >/dev/null
  changed "allowed passkeys and security keys, and set seat expiration to 1 month"
fi

say "5. Access applications (K-104, K-1204)"
NEED='"Account > Access: Apps and Policies > Edit"'
APPS=$(api GET "/accounts/$ACCOUNT/access/apps?per_page=1000")
POLICIES=$(api GET "/accounts/$ACCOUNT/access/policies?per_page=1000")
# policy NAME JSON: prints the id of the reusable policy NAME, and creates it when it is missing.
policy() {
  id=$(printf '%s' "$POLICIES" | jq -r --arg name "$1" 'map(select(.name == $name)) | .[0].id // empty')
  if [ -n "$id" ]; then
    kept "policy \"$1\"" >&2
  else
    created=$(api POST "/accounts/$ACCOUNT/access/policies" "$2")
    id=$(printf '%s' "$created" | jq -r .id)
    changed "created the policy \"$1\"" >&2
  fi
  printf '%s' "$id"
}
# with_page APP_JSON PAGE: the application with the kitshn login page PAGE (K-1130), as the body of a PUT.
with_page() {
  printf '%s' "$1" | jq -c --arg page "$2" 'del(.id, .uid, .aud, .created_at, .updated_at, .scim_config)
    | .policies = [(.policies // [])[] | {id} + (if .precedence == null then {} else {precedence} end)]
    | .custom_pages = [$page]'
}
# set_page APP_JSON PAGE: gives a kitshn application the login page PAGE when it has another one.
set_page() {
  [ -n "$2" ] || return 0
  printf '%s' "$1" | jq -e --arg page "$2" '(.custom_pages // []) == [$page]' >/dev/null && return 0
  api PUT "/accounts/$ACCOUNT/access/apps/$(printf '%s' "$1" | jq -r .id)" "$(with_page "$1" "$2")" >/dev/null
  changed "gave \"$(printf '%s' "$1" | jq -r .name)\" the kitshn login page (K-1130)" >&2
}
# app DOMAIN NAME SESSION POLICY_ID [PAGE]: prints the audience tag of the application on DOMAIN. It never
# changes an application that it did not make (K-408), and gives the ones it made the login page PAGE (K-1130).
app() {
  found=$(printf '%s' "$APPS" | jq -c --arg domain "$1" 'map(select(.domain == $domain)) | .[0] // empty')
  if [ -n "$found" ]; then
    name=$(printf '%s' "$found" | jq -r .name)
    case "$name" in
    kitshn*)
      kept "application \"$name\" on $1" >&2
      set_page "$found" "${5:-}"
      ;;
    *) die "the Access application \"$name\" already covers $1. kitshn does not change it. Remove it or pick another KITSHN_HOST." ;;
    esac
    printf '%s' "$found" | jq -r .aud
    return
  fi
  body=$(jq -nc --arg domain "$1" --arg name "$2" --arg session "$3" --arg policy "$4" \
    --arg page "${5:-}" \
    '{name:$name,type:"self_hosted",domain:$domain,session_duration:$session,same_site_cookie_attribute:"lax"} + (if $policy == "" then {} else {policies:[{id:$policy,precedence:1}]} end) + (if $page == "" then {} else {custom_pages:[$page]} end)')
  created=$(api POST "/accounts/$ACCOUNT/access/apps" "$body")
  changed "created the application \"$2\" on $1" >&2
  printf '%s' "$created" | jq -r .aud
}
# After the first run the Worker owns the admin application and the Owner policy, and it may rename
# the policy with the circle. So the script makes the Owner policy only with a new admin application.
owner_policy=""
if ! printf '%s' "$APPS" | jq -e --arg d "$KITSHN_HOST" 'any(.[]; .domain == $d)' >/dev/null; then
  owner_rules=$(printf '%s' "$KITSHN_OWNER_EMAILS" | jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$"; "") | select(length > 0) | {email: {email: .}})')
  owner_policy=$(policy "kitshn circle Owner" "$(jq -nc --argjson include "$owner_rules" --argjson mfa "$MFA" \
    '{name:"kitshn circle Owner",decision:"allow",include:$include,require:[],exclude:[],mfa_config:$mfa}')")
fi
public_policy=$(policy "kitshn public paths" '{"name":"kitshn public paths","decision":"bypass","include":[{"everyone":{}}],"require":[],"exclude":[]}')
machines_policy=$(policy "kitshn machines" '{"name":"kitshn machines","decision":"non_identity","include":[{"any_valid_service_token":{}}],"require":[],"exclude":[]}')
# K-1130: the kitshn Access login pages, so no kitshn application shows the bare Cloudflare login: "chef" for a card that
# only the Owner circle opens, "closed" for a card in no circle, and "login" for every other one. Optional: without
# "Account > Access: Custom Pages > Edit", or on a plan that refuses login pages, the applications keep the Cloudflare login.
# A login page must show the Cloudflare sign-in box and allows no script, so "closed" keeps it under a note.
login_page_html() {
  cat <<'HTML'
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ app_domain }}</title>
<style>
:root { color-scheme: light; --canvas: #E4E7FF; --dots: #00000026; --surface: #FFFFFF; --ink: #000000; --muted: #3D3D5C;
  --border: #000000; --shadow-ink: #000000; --select: #FFE14D; --pink: #FF9EB0; --green: #7CFF8A;
  --sans: "Bricolage Grotesque", system-ui, sans-serif; --mono: "JetBrains Mono", ui-monospace, monospace; }
@media (prefers-color-scheme: dark) {
  :root { color-scheme: dark; --canvas: #15122B; --dots: #F3F0FF22; --surface: #262147; --ink: #F3F0FF;
    --muted: #BDB6E6; --border: #F3F0FF; --shadow-ink: #B9A8FF; --select: #6C5CE7; }
}
* { box-sizing: border-box; }
html { font-size: 18px; }
body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; font: 1rem/1.5 var(--sans);
  color: var(--ink); background-color: var(--canvas); background-size: 16px 16px;
  background-image: radial-gradient(var(--dots) 1.2px, transparent 1.2px); }
main { width: min(30rem, 100%); padding: 24px; background: var(--surface); border: 2px solid var(--border);
  border-radius: 0.25rem; box-shadow: 4px 4px 0 0 var(--shadow-ink); }
.sticker { display: inline-block; margin-right: 6px; padding: 0 6px; font-size: 0.65rem; font-weight: 800;
  letter-spacing: 0.04em; text-transform: uppercase; color: #000000; background: var(--pink);
  border: 2px solid var(--shadow-ink); border-radius: 4px; box-shadow: 2px 2px 0 0 var(--shadow-ink); transform: rotate(-3deg); }
.sticker.ok { background: var(--green); }
code { font-family: var(--mono); font-size: 0.85em; padding: 0 2px;
  background: linear-gradient(transparent 35%, var(--select) 35%, var(--select) 88%, transparent 88%); }
h1 { margin: 16px 0 4px; font-size: 1.6rem; font-weight: 800; letter-spacing: -0.01em; }
p { margin: 0 0 16px; color: var(--muted); }
.note { margin: 0 0 8px; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
</style>
</head>
<body>
<main>
HTML
  case "$1" in
  chef) cat <<'HTML'
<span class="sticker">closed</span><code>{{ app_domain }}</code>
<h1>Let me in, I'm the chef</h1>
<p>This place is closed. Only the chef gets in.</p>
HTML
    ;;
  closed) cat <<'HTML'
<span class="sticker">closed</span><code>{{ app_domain }}</code>
<h1>This place is closed.</h1>
<p class="note">Sign in (only for people with access)</p>
HTML
    ;;
  login) cat <<'HTML'
<span class="sticker ok">kitshn</span><code>{{ app_domain }}</code>
<h1>{{ app_name | remove_first: "kitshn " }}</h1>
<p>Sign in to open it.</p>
HTML
    ;;
  esac
  cat <<'HTML'
<cf-access-authbox></cf-access-authbox>
HTML
  # K-1130: the public help page of K-1132, for a visitor who does not know this login.
  printf '<p class="note"><a href="https://%s/public/help/login">What is this login?</a></p>\n' "$KITSHN_HOST"
  cat <<'HTML'
</main>
</body>
</html>
HTML
}
LOGIN_PAGES=""
if ! try GET "/accounts/$ACCOUNT/access/custom_pages"; then
  say "  warning: the token has no \"Account > Access: Custom Pages > Edit\", so kitshn applications show the Cloudflare login"
  say "           (K-1130). To add it, edit the token at $TOKEN_PAGE, then Update token."
else
  cp "$WORK/out" "$WORK/pages.json"
  ids="{}"
  for kind in chef closed login; do
    name="kitshn $kind"
    html=$(login_page_html "$kind")
    id=$(jq -r --arg name "$name" '[.result[] | select(.name == $name and .type == "login")] | .[0] | (.uid // .id) // empty' "$WORK/pages.json")
    jq -nc --arg name "$name" --arg html "$html" '{name:$name,type:"login",custom_html:$html}' >"$WORK/body"
    call=""
    if [ -z "$id" ]; then
      call="POST /accounts/$ACCOUNT/access/custom_pages"
    elif try GET "/accounts/$ACCOUNT/access/custom_pages/$id" && [ "$(jq -r '.result.custom_html' "$WORK/out")" = "$html" ]; then
      kept "login page \"$name\""
    else
      call="PUT /accounts/$ACCOUNT/access/custom_pages/$id"
    fi
    if [ -n "$call" ]; then
      curl -sS -X "${call%% *}" "$API${call#* }" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
        -H "Content-Type: application/json" --data-binary "@$WORK/body" >"$WORK/out" 2>/dev/null || true
      if [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" = true ]; then
        id=$(jq -r '.result | (.uid // .id)' "$WORK/out")
        changed "wrote the login page \"$name\" (K-1130)"
      else
        say "  warning: Cloudflare refused the login page \"$name\": $(jq -r '[.errors[]? | "\(.code): \(.message)"] | join("; ")' "$WORK/out" 2>/dev/null || head -c 200 "$WORK/out")"
        id=""
      fi
    fi
    ids=$(printf '%s' "$ids" | jq -c --arg kind "$kind" --arg id "$id" '. + {($kind): $id}')
  done
  # All three or none, so no application points at a page that is missing.
  if printf '%s' "$ids" | jq -e '.chef != "" and .closed != "" and .login != ""' >/dev/null; then
    LOGIN_PAGES=$ids
  else
    say "           kitshn applications keep the Cloudflare login (K-1130)."
  fi
fi
# page KIND: the id of the kitshn login page KIND, or nothing without the pages.
page() { [ -n "$LOGIN_PAGES" ] && printf '%s' "$LOGIN_PAGES" | jq -r --arg kind "$1" '.[$kind]'; return 0; }
# K-1209: during the host move the Worker also takes the old host and the audience tags of its applications. A run
# without KITSHN_OLD_HOST keeps the value of the running Worker, and KITSHN_OLD_HOST=none ends the move.
if [ -z "${KITSHN_OLD_HOST:-}" ] && try GET "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/settings"; then
  KITSHN_OLD_HOST=$(jq -r '.result.bindings[]? | select(.name == "KITSHN_OLD_HOST") | .text // empty' "$WORK/out")
fi
[ "${KITSHN_OLD_HOST:-}" = none ] && KITSHN_OLD_HOST=""
KITSHN_OLD_HOST=$(printf '%s' "${KITSHN_OLD_HOST:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
KITSHN_OLD_HOST=${KITSHN_OLD_HOST%.}
case "$KITSHN_OLD_HOST" in "" | *".$ZONE_NAME") ;; *) die "KITSHN_OLD_HOST=$KITSHN_OLD_HOST is not a host under $ZONE_NAME (K-1209)." ;; esac
# with_old TAG PATH: TAG, and during the move also the tag of the old host's kitshn application on PATH.
with_old() {
  old=""
  [ -n "$KITSHN_OLD_HOST" ] && old=$(printf '%s' "$APPS" | jq -r --arg d "$KITSHN_OLD_HOST$2" \
    'map(select(.domain == $d and (.name | startswith("kitshn")))) | .[0].aud // empty')
  [ -n "$KITSHN_OLD_HOST" ] && [ -z "$old" ] &&
    printf 'warning: no kitshn application covers %s%s, so only the new host takes this path (K-1209).\n' "$KITSHN_OLD_HOST" "$2" >&2
  if [ -n "$old" ] && [ "$old" != "$1" ]; then printf '%s,%s' "$1" "$old"; else printf '%s' "$1"; fi
}
ADMIN_AUD=$(with_old "$(app "$KITSHN_HOST" "kitshn admin" 24h "$owner_policy")" "")
app "$KITSHN_HOST/install" "kitshn install (public)" 24h "$public_policy" >/dev/null
# K-602: the join script and the join code exchange. The one-time code protects the exchange.
app "$KITSHN_HOST/join" "kitshn join (public)" 24h "$public_policy" >/dev/null
# K-811: GitHub Actions deploys here; the Worker checks its OIDC token.
app "$KITSHN_HOST/deploy" "kitshn deploy (public)" 24h "$public_policy" >/dev/null
# K-1908: apps send their notifications here; the Worker checks each notify token itself.
app "$KITSHN_HOST/notify" "kitshn notify (public)" 24h "$public_policy" >/dev/null
# K-1118: the list of public app cards, for sites such as kitshn.com.
app "$KITSHN_HOST/public/cards.json" "kitshn public cards (public)" 24h "$public_policy" >/dev/null
# K-1119: deploy badges for READMEs. The path covers every badge below it.
app "$KITSHN_HOST/public/badges" "kitshn badges (public)" 24h "$public_policy" >/dev/null
# K-1132: the help pages: "What is this login?" and the page that Access sends a refused visitor to.
app "$KITSHN_HOST/public/help" "kitshn help (public)" 24h "$public_policy" >/dev/null
# The Worker makes the application of /ask itself, from the people of the circles, so no stranger takes a seat (K-111).
CONNECT_AUD=$(with_old "$(app "$KITSHN_HOST/connect" "kitshn connect" 24h "$machines_policy" "$(page login)")" /connect)
# K-718: agent keys reach /agent with their service token; the Worker decides what each key may do.
AGENT_AUD=$(with_old "$(app "$KITSHN_HOST/agent" "kitshn agent keys" 24h "$machines_policy" "$(page login)")" /agent)
# K-1601: phones and desktop apps read their machines here with their service token; the Worker decides what each opens.
DEVICE_AUD=$(with_old "$(app "$KITSHN_HOST/device" "kitshn devices" 24h "$machines_policy" "$(page login)")" /device)
# K-1504: "Resume" needs a fresh passkey: a 10-minute application and MFA session for the owner emails.
fresh_rules=$(printf '%s' "$KITSHN_OWNER_EMAILS" | jq -Rc 'split(",") | map(gsub("^\\s+|\\s+$"; "") | select(length > 0) | {email: {email: .}})')
fresh_policy=$(policy "kitshn fresh passkey" "$(jq -nc --argjson include "$fresh_rules" \
  '{name:"kitshn fresh passkey",decision:"allow",include:$include,require:[],exclude:[],mfa_config:{allowed_authenticators:["biometrics","security_key"],session_duration:"10m"}}')")
# Its cookie stays on its path, so the admin application's cookie of the whole host does not replace it.
FRESH_AUD=$(printf '%s' "$APPS" | jq -r --arg d "$KITSHN_HOST/api/fresh" 'map(select(.domain == $d)) | .[0].aud // empty')
fresh_name=$(printf '%s' "$APPS" | jq -r --arg d "$KITSHN_HOST/api/fresh" 'map(select(.domain == $d)) | .[0].name // empty')
case "$fresh_name" in "" | kitshn*) ;; *) die "the Access application \"$fresh_name\" already covers $KITSHN_HOST/api/fresh. kitshn does not change it." ;; esac
if [ -n "$FRESH_AUD" ]; then
  kept "application \"kitshn fresh passkey\" on $KITSHN_HOST/api/fresh"
  set_page "$(printf '%s' "$APPS" | jq -c --arg d "$KITSHN_HOST/api/fresh" 'map(select(.domain == $d)) | .[0]')" "$(page chef)"
else
  FRESH_AUD=$(api POST "/accounts/$ACCOUNT/access/apps" "$(jq -nc --arg domain "$KITSHN_HOST/api/fresh" --arg policy "$fresh_policy" \
    --arg page "$(page chef)" \
    '{name:"kitshn fresh passkey",type:"self_hosted",domain:$domain,session_duration:"10m",same_site_cookie_attribute:"lax",path_cookie_attribute:true,policies:[{id:$policy,precedence:1}]} + (if $page == "" then {} else {custom_pages:[$page]} end)')" | jq -r .aud)
  changed "created the application \"kitshn fresh passkey\" on $KITSHN_HOST/api/fresh"
fi
FRESH_AUD=$(with_old "$FRESH_AUD" /api/fresh)
# K-1004: pages and files have no Access application on the whole host; the Worker checks the shares.
# Only the login paths have one. The Worker gives them the policies of the circles that may log in, so
# the script makes them with the machines policy only (the passkey paths with none) and never changes
# their policies later (K-1205). The Worker reads who logged in from the cookie that Access sets for the
# whole host.
PAGES_LOGIN_AUD=$(app "pages.$ZONE_NAME/login" "kitshn pages login" 720h "$machines_policy")
PAGES_PASSKEY_AUD=$(app "pages.$ZONE_NAME/login/passkey" "kitshn pages login (passkey)" 24h "")
FILES_LOGIN_AUD=$(app "files.$ZONE_NAME/login" "kitshn files login" 720h "$machines_policy")
FILES_PASSKEY_AUD=$(app "files.$ZONE_NAME/login/passkey" "kitshn files login (passkey)" 24h "")

say "6. R2 bucket"
NEED='"Account > Workers R2 Storage > Edit"'
R2=""
if try GET "/accounts/$ACCOUNT/r2/buckets"; then
  if jq -e '.result.buckets // [] | any(.name == "kitshn")' "$WORK/out" >/dev/null; then
    kept "R2 bucket kitshn"
  else
    api POST "/accounts/$ACCOUNT/r2/buckets" '{"name":"kitshn"}' >/dev/null
    changed "created the R2 bucket kitshn"
  fi
  R2=kitshn
  # K-1833: the export waits in R2; the Durable Object imports it once when it sees the new KITSHN_IMPORT_AT.
  if [ -n "${KITSHN_IMPORT:-}" ]; then
    case "$KITSHN_IMPORT" in
    *.gz) cp "$KITSHN_IMPORT" "$WORK/import.json.gz" ;;
    *) gzip -c "$KITSHN_IMPORT" >"$WORK/import.json.gz" ;;
    esac
    curl -sS -X PUT "$API/accounts/$ACCOUNT/r2/buckets/kitshn/objects/import%2Fstate.json.gz" \
      -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "content-type: application/gzip" \
      --data-binary "@$WORK/import.json.gz" >"$WORK/out"
    [ "$(jq -r .success "$WORK/out")" = true ] || die "the upload of the import failed: $(head -c 300 "$WORK/out")"
    IMPORT_AT=$(date +%s)
    changed "uploaded $KITSHN_IMPORT for the import (K-1833)"
  fi
  # K-812: the files of a Compose deploy go when its job ends; a rule removes any left after a day.
  rules=$(api GET "/accounts/$ACCOUNT/r2/buckets/kitshn/lifecycle")
  if printf '%s' "$rules" | jq -e '.rules // [] | any(.id == "kitshn deploys")' >/dev/null; then
    kept "R2 rule: deploy files expire after a day"
  else
    wanted=$(printf '%s' "$rules" | jq -c '{rules: ((.rules // []) + [{id: "kitshn deploys", enabled: true, conditions: {prefix: "deploys/"}, deleteObjectsTransition: {condition: {type: "Age", maxAge: 86400}}}])}')
    api PUT "/accounts/$ACCOUNT/r2/buckets/kitshn/lifecycle" "$wanted" >/dev/null
    changed "R2 rule: deploy files expire after a day"
  fi
elif grep -q "enable R2" "$WORK/out"; then
  say "  later:   R2 is off on this account. Turn it on at https://dash.cloudflare.com/$ACCOUNT/r2/overview,"
  say "           then run this script again. Pages and files (milestone 3) need it; the map does not."
else
  die "the R2 check failed: $(jq -r '[.errors[]?.message] | join("; ")' "$WORK/out")"
fi

[ -z "${KITSHN_IMPORT:-}" ] || [ -n "$R2" ] || die "KITSHN_IMPORT needs R2, which is off on this account (K-1833)."

say "7. Worker (K-1203)"
NEED='"Account > Workers Scripts > Edit"'
case "$BUNDLE" in
http*) curl -fsSL "$BUNDLE" -o "$WORK/bundle.tar.gz" || die "cannot download the kitshn bundle from $BUNDLE." ;;
*) cp "$BUNDLE" "$WORK/bundle.tar.gz" ;;
esac
mkdir "$WORK/bundle"
tar -xzf "$WORK/bundle.tar.gz" -C "$WORK/bundle"
say "  bundle version $(cat "$WORK/bundle/version")"
manifest=$(jq -c 'map_values({hash, size})' "$WORK/bundle/assets.json")
session=$(api POST "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/assets-upload-session" "$(jq -nc --argjson m "$manifest" '{manifest:$m}')")
assets_jwt=$(printf '%s' "$session" | jq -r .jwt)
for bucket in $(printf '%s' "$session" | jq -r '.buckets[]? | join(",")'); do
  set --
  for hash in $(printf '%s' "$bucket" | tr ',' ' '); do
    type=$(jq -r --arg h "$hash" 'to_entries[] | select(.value.hash == $h) | .value.type' "$WORK/bundle/assets.json" | head -1)
    base64 <"$WORK/bundle/assets/$(printf '%s' "$hash" | cut -c1-2)/$hash" | tr -d '\n' >"$WORK/$hash.b64"
    set -- "$@" -F "$hash=@$WORK/$hash.b64;filename=$hash;type=$type"
  done
  # Files are keyed by their hash, so a failed upload is safe to repeat; it tries again after 5 s and 15 s.
  for pause in 5 15 last; do
    curl -sS -X POST "$API/accounts/$ACCOUNT/workers/assets/upload?base64=true" -H "Authorization: Bearer $assets_jwt" "$@" >"$WORK/out" || true
    [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" = true ] && break
    [ "$pause" = last ] && break
    sleep "$pause"
  done
  [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" = true ] || die "the asset upload failed: $(head -c 300 "$WORK/out")"
  next=$(jq -r '.result.jwt // empty' "$WORK/out")
  if [ -n "$next" ]; then assets_jwt=$next; fi
done
migrations='{"new_tag":"v1","new_sqlite_classes":["Kitshn"]}'
settings="{}"
scripts=$(api GET "/accounts/$ACCOUNT/workers/scripts")
if printf '%s' "$scripts" | jq -e --arg s "$SCRIPT" 'any(.[]; .id == $s)' >/dev/null; then
  settings=$(api GET "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/settings")
  printf '%s' "$settings" | jq -e 'any(.bindings[]?; .type == "durable_object_namespace" and .class_name == "Kitshn")' >/dev/null ||
    die "a Worker named $SCRIPT exists and it is not kitshn. kitshn does not overwrite it."
fi
# K-811: the GitHub owners that may deploy, as user ids, which never change hands like a name can.
DEPLOY_OWNER_IDS=$(printf "%s" "$settings" | jq -r '[.bindings[]? | select(.name == "DEPLOY_OWNER_IDS") | .text][0] // ""')
if [ -n "${KITSHN_DEPLOY_OWNERS:-}" ]; then
  DEPLOY_OWNER_IDS=""
  for login in $(printf '%s' "$KITSHN_DEPLOY_OWNERS" | tr ',' ' '); do
    # K-811: user accounts only; an organization is not on the list for now.
    id=$(curl -fsS "https://api.github.com/users/$login" | jq -r 'select(.type == "User") | .id // empty') || die "GitHub knows no user $login."
    [ -n "$id" ] || die "$login is not a GitHub user account (K-811)."
    DEPLOY_OWNER_IDS="${DEPLOY_OWNER_IDS:+$DEPLOY_OWNER_IDS,}$id"
  done
  kept "deploys from GitHub owners $KITSHN_DEPLOY_OWNERS ($DEPLOY_OWNER_IDS)"
fi
# K-1111, K-817: the further zones that kitshn publishes on, as JSON of zone name to id. A second run keeps them
# when KITSHN_ZONES is not set. Known limit: the check reads DNS only; a token without DNS edit fails at the deploy.
ZONES_JSON=$(printf "%s" "$settings" | jq -r '[.bindings[]? | select(.name == "KITSHN_ZONES") | .text][0] // ""')
if [ -n "${KITSHN_ZONES:-}" ]; then
  ZONES_JSON='{}'
  for name in $(printf '%s' "$KITSHN_ZONES" | tr ',' ' '); do
    [ "$name" = "$ZONE_NAME" ] && continue
    id=$(printf '%s' "$zones" | jq -r --arg n "$name" '.[] | select(.name == $n) | .id // empty')
    [ -n "$id" ] || die "the token sees no zone $name in this account (K-1111)."
    NEED="\"Zone > DNS > Edit\" on $name"
    api GET "/zones/$id/dns_records?per_page=1" >/dev/null
    ZONES_JSON=$(printf '%s' "$ZONES_JSON" | jq -c --arg n "$name" --arg id "$id" '. + {($n): $id}')
  done
  kept "further zones $KITSHN_ZONES"
fi
if [ "$(printf '%s' "$scripts" | jq -r --arg s "$SCRIPT" 'map(select(.id == $s)) | .[0].migration_tag // empty')" = v1 ]; then
  migrations=null
fi
# run_worker_first: the offline routes of live sites (K-1108) need the Worker before the map's assets.
metadata=$(jq -nc --arg jwt "$assets_jwt" --arg date "$COMPATIBILITY_DATE" --argjson migrations "$migrations" \
  --arg host "$KITSHN_HOST" --arg old_host "$KITSHN_OLD_HOST" --arg login_pages "$LOGIN_PAGES" --arg team "$TEAM" --arg admin_aud "$ADMIN_AUD" --arg connect_aud "$CONNECT_AUD" --arg agent_aud "$AGENT_AUD" --arg device_aud "$DEVICE_AUD" --arg fresh_aud "$FRESH_AUD" \
  --arg owners "$KITSHN_OWNER_EMAILS" --arg devices "${KITSHN_OWNER_DEVICES:-}" --arg account "$ACCOUNT" \
  --arg zone "$ZONE" --arg zone_name "$ZONE_NAME" --arg zones "$ZONES_JSON" --arg deployers "$DEPLOY_OWNER_IDS" \
  --arg version "$(cat "$WORK/bundle/version")" --arg r2 "$R2" --arg pages_login "$PAGES_LOGIN_AUD" \
  --arg pages_passkey "$PAGES_PASSKEY_AUD" --arg files_login "$FILES_LOGIN_AUD" --arg files_passkey "$FILES_PASSKEY_AUD" \
  --arg import_at "${IMPORT_AT:-}" '
  {
    main_module: "worker.js",
    # K-1806: the kitshn Worker logs to Workers Logs too, so its alarm runs can be searched and timed.
    observability: {enabled: true},
    compatibility_date: $date,
    compatibility_flags: ["nodejs_compat"],
    assets: {jwt: $jwt, config: {not_found_handling: "single-page-application", run_worker_first: true}},
    bindings: [
      {type: "assets", name: "ASSETS"},
      {type: "durable_object_namespace", name: "KITSHN", class_name: "Kitshn"},
      {type: "plain_text", name: "KITSHN_HOST", text: $host},
      {type: "plain_text", name: "ACCESS_TEAM_DOMAIN", text: $team},
      {type: "plain_text", name: "ACCESS_ADMIN_AUD", text: $admin_aud},
      {type: "plain_text", name: "ACCESS_CONNECT_AUD", text: $connect_aud},
      {type: "plain_text", name: "ACCESS_AGENT_AUD", text: $agent_aud},
      {type: "plain_text", name: "ACCESS_DEVICE_AUD", text: $device_aud},
      {type: "plain_text", name: "ACCESS_FRESH_AUD", text: $fresh_aud},
      {type: "plain_text", name: "KITSHN_HELP_PAGES", text: "1"},
      {type: "plain_text", name: "OWNER_EMAILS", text: $owners},
      {type: "plain_text", name: "OWNER_DEVICES", text: $devices},
      {type: "plain_text", name: "CLOUDFLARE_ACCOUNT_ID", text: $account},
      {type: "plain_text", name: "CLOUDFLARE_ZONE_ID", text: $zone},
      {type: "plain_text", name: "KITSHN_ZONE", text: $zone_name},
      {type: "plain_text", name: "KITSHN_ZONES", text: $zones},
      {type: "plain_text", name: "DEPLOY_OWNER_IDS", text: $deployers},
      {type: "plain_text", name: "KITSHN_VERSION", text: $version},
      {type: "plain_text", name: "PAGES_LOGIN_AUD", text: $pages_login},
      {type: "plain_text", name: "PAGES_PASSKEY_AUD", text: $pages_passkey},
      {type: "plain_text", name: "FILES_LOGIN_AUD", text: $files_login},
      {type: "plain_text", name: "FILES_PASSKEY_AUD", text: $files_passkey}
    ] + (if $old_host == "" then [] else [{type: "plain_text", name: "KITSHN_OLD_HOST", text: $old_host}] end)
      + (if $login_pages == "" then [] else [{type: "plain_text", name: "KITSHN_LOGIN_PAGES", text: $login_pages}] end)
      + (if $r2 == "" then [] else [{type: "r2_bucket", name: "BUCKET", bucket_name: $r2}] end)
      + (if $import_at == "" then [] else [{type: "plain_text", name: "KITSHN_IMPORT_AT", text: $import_at}] end),
    keep_bindings: ["secret_text"]
  } + (if $migrations == null then {} else {migrations: $migrations} end)')
printf '%s' "$metadata" >"$WORK/metadata.json"
http_status=$(curl -sS -o "$WORK/out" -w '%{http_code}' -X PUT "$API/accounts/$ACCOUNT/workers/scripts/$SCRIPT" \
  -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" \
  -F "metadata=@$WORK/metadata.json;type=application/json" \
  -F "worker.js=@$WORK/bundle/worker.js;type=application/javascript+module") || die "the Worker upload got no answer from Cloudflare."
if [ "$(jq -r '.success // false' "$WORK/out" 2>/dev/null)" != true ]; then
  # An answer that is not JSON, such as a proxy error page, has no errors list; its start says more.
  errors=$(jq -r '[.errors[]? | "\(.code): \(.message)"] | join("; ")' "$WORK/out" 2>/dev/null || head -c 300 "$WORK/out")
  die "the Worker upload failed ($http_status): $errors"
fi
changed "uploaded the Worker $SCRIPT"
secrets=$(api GET "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/secrets")
if printf '%s' "$secrets" | jq -e 'any(.[]; .name == "CLOUDFLARE_API_TOKEN")' >/dev/null && [ "${KITSHN_SET_TOKEN:-}" != 1 ]; then
  kept "Worker secret CLOUDFLARE_API_TOKEN (set KITSHN_SET_TOKEN=1 to replace it)"
else
  api PUT "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/secrets" \
    "$(jq -nc --arg token "$CLOUDFLARE_API_TOKEN" '{name:"CLOUDFLARE_API_TOKEN",text:$token,type:"secret_text"}')" >/dev/null
  changed "stored the API token as the Worker secret CLOUDFLARE_API_TOKEN (K-406)"
fi
if { [ -n "${KITSHN_GITHUB_APP_ID:-}" ] && [ -z "${KITSHN_GITHUB_APP_KEY:-}" ]; } || { [ -z "${KITSHN_GITHUB_APP_ID:-}" ] && [ -n "${KITSHN_GITHUB_APP_KEY:-}" ]; }; then
  die "set both KITSHN_GITHUB_APP_ID and KITSHN_GITHUB_APP_KEY, or neither"
fi
has_app=$(printf '%s' "$secrets" | jq 'any(.[]; .name == "GITHUB_APP_KEY") and any(.[]; .name == "GITHUB_APP_ID")')
if [ -n "${KITSHN_GITHUB_APP_ID:-}" ] && { [ "$has_app" != true ] || [ "${KITSHN_SET_GITHUB_APP:-}" = 1 ]; }; then
  [ -r "$KITSHN_GITHUB_APP_KEY" ] || die "KITSHN_GITHUB_APP_KEY names no readable file: $KITSHN_GITHUB_APP_KEY"
  api PUT "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/secrets" \
    "$(jq -nc --arg id "$KITSHN_GITHUB_APP_ID" '{name:"GITHUB_APP_ID",text:$id,type:"secret_text"}')" >/dev/null
  api PUT "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/secrets" \
    "$(jq -nc --rawfile key "$KITSHN_GITHUB_APP_KEY" '{name:"GITHUB_APP_KEY",text:$key,type:"secret_text"}')" >/dev/null
  changed "stored the GitHub App id and key as Worker secrets (K-718)"
elif [ "$has_app" = true ]; then
  kept "Worker secrets GITHUB_APP_ID and GITHUB_APP_KEY (set KITSHN_SET_GITHUB_APP=1 to replace them)"
else
  say "  note:    no GitHub App; agent keys cannot start builds until KITSHN_GITHUB_APP_ID and KITSHN_GITHUB_APP_KEY are set"
fi
# K-1815: the key of the backup passwords, made once. Cloudflare never shows a secret again, so the owner keeps
# this copy outside Cloudflare; without it nobody can read the backups.
# It is made only on request and only for a terminal, so the owner saves it and it never lands in a log file.
# `sh -x` (which traces the key to stderr) or a terminal recorder is the owner's own choice; the script cannot see it.
if printf '%s' "$secrets" | jq -e 'any(.[]; .name == "KITSHN_BACKUP_KEY")' >/dev/null; then
  kept "Worker secret KITSHN_BACKUP_KEY (K-1815)"
elif [ "${KITSHN_BACKUP_KEY_NOW:-}" != 1 ]; then
  say "  backups stay off until you run the bootstrap with KITSHN_BACKUP_KEY_NOW=1 (K-1815)"
elif [ ! -t 1 ]; then
  die "KITSHN_BACKUP_KEY_NOW=1 prints the backup key once; run it in a terminal, with no pipe or file (K-1815)."
else
  backup_key=$(head -c 32 /dev/urandom | base64 | tr -d '\n')
  api PUT "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/secrets" \
    "$(printf '%s' "$backup_key" | jq -Rc '{name:"KITSHN_BACKUP_KEY",text:.,type:"secret_text"}')" >/dev/null
  changed "made the backup key (K-1815). Keep it in your password manager; kitshn shows it only now:"
  say "           $backup_key"
fi
# The workers.dev address would skip Access. The Worker refuses requests without an Access token
# anyway, but kitshn keeps that address off.
api POST "/accounts/$ACCOUNT/workers/scripts/$SCRIPT/subdomain" '{"enabled":false,"previews_enabled":false}' >/dev/null
kept "workers.dev address off"

say "8. Addresses (K-1208, K-1003, K-1102)"
NEED='"Zone > Workers Routes > Edit" and "Zone > DNS > Edit"'
for host in "$KITSHN_HOST" "pages.$ZONE_NAME" "files.$ZONE_NAME"; do
  domains=$(api GET "/accounts/$ACCOUNT/workers/domains?hostname=$host")
  domain=$(printf '%s' "$domains" | jq -r --arg h "$host" 'map(select(.hostname == $h)) | .[0].service // empty')
  if [ "$domain" = "$SCRIPT" ]; then
    kept "$host serves the Worker"
  elif [ -n "$domain" ]; then
    die "$host already serves the Worker \"$domain\". kitshn does not take it over."
  else
    api PUT "/accounts/$ACCOUNT/workers/domains" \
      "$(jq -nc --arg h "$host" --arg z "$ZONE" --arg s "$SCRIPT" '{hostname:$h,zone_id:$z,service:$s,environment:"production"}')" >/dev/null
    changed "$host now serves the Worker"
  fi
done
# K-412: the Worker keeps one Configuration Rule per zone that turns Browser Integrity Check off on private cards, so
# scripts and machines reach them. The rule needs "Zone > Config Rules > Edit"; without it, the map shows a notification.
zone_ids=$ZONE
if [ -n "$ZONES_JSON" ]; then zone_ids="$zone_ids $(printf '%s' "$ZONES_JSON" | jq -r '.[]')"; fi
for zone_id in $zone_ids; do
  status=$(curl -sS -o "$WORK/out" -w '%{http_code}' "$API/zones/$zone_id/rulesets/phases/http_config_settings/entrypoint" \
    -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" 2>&1) || status="no answer"
  case "$status" in
  200 | 404) kept "Configuration Rules of zone $zone_id (K-412)" ;;
  401 | 403)
    say "  warning: the token has no \"Zone > Config Rules > Edit\" on zone $zone_id, so private cards keep the"
    say "           Browser Integrity Check, which refuses many scripts and machines (K-412). To add it, edit the token at"
    say "           $TOKEN_PAGE, then Update token."
    ;;
  *) say "  warning: the check of the Configuration Rules of zone $zone_id failed ($status): $(jq -r '[.errors[]?.message] | join("; ")' "$WORK/out" 2>/dev/null || head -c 200 "$WORK/out")" ;;
  esac
done

if [ -n "${IMPORT_AT:-}" ]; then
  say "9. Import (K-1833)"
  answer=""
  for _ in $(seq 1 24); do
    answer=$(curl -fsS "https://$KITSHN_HOST/join/import-status" 2>/dev/null || true)
    case "$(printf '%s' "$answer" | jq -r '.state // empty' 2>/dev/null)" in
    done)
      changed "imported $KITSHN_IMPORT; History names the import"
      break
      ;;
    refused) die "kitshn refused the import ($(printf '%s' "$answer" | jq -r .code)); the Worker log names the details (K-1833)." ;;
    esac
    sleep 5
  done
  printf '%s' "$answer" | jq -e '.state == "done"' >/dev/null 2>&1 ||
    die "kitshn did not answer the import within 2 minutes; check https://$KITSHN_HOST/join/import-status"
fi

say ""
say "kitshn is ready: https://$KITSHN_HOST"
say "First login: register a passkey or a security key in the App Launcher, https://$TEAM (K-1206)."
say "Then open https://$KITSHN_HOST and log in with your email code and the passkey."
